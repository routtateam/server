# ---------------------------------------------------------------------------
# Routta backend — environment configuration
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a real `.env` file. This file only documents the shape.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (the 4 frontends in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5184,capacitor://localhost,http://localhost

# --- PostgreSQL (via Knex) ---
DATABASE_URL=postgres://routta:routta@localhost:5432/routta_dev
# Individual fallbacks, used if DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_USER=routta
DB_PASSWORD=routta
DB_NAME=routta_dev
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Redis (BullMQ job queues) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_LENGTH=6
BCRYPT_SALT_ROUNDS=10

# --- Monnify (payments) — SANDBOX / STUB ONLY ---
# Real credentials are NOT provided yet. Adapter runs in mock mode unless
# MONNIFY_LIVE_MODE=true and real keys are supplied. See src/integrations/monnify.
MONNIFY_LIVE_MODE=false
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=MK_TEST_XXXXXXXXXXXXXXXX
MONNIFY_SECRET_KEY=CHANGE_ME_SANDBOX_SECRET
MONNIFY_CONTRACT_CODE=1234567890
MONNIFY_WEBHOOK_SECRET=change-me-webhook-secret

# --- Resend (transactional email) — STUB ONLY ---
# No real key yet. Adapter logs emails in dev mode instead of sending.
RESEND_LIVE_MODE=false
RESEND_API_KEY=re_test_XXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL="Routta <no-reply@routta.app>"

# --- Termii (SMS / OTP) — STUB ONLY ---
# No real key yet. Adapter logs SMS in dev mode instead of sending.
TERMII_LIVE_MODE=false
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=TL_TEST_XXXXXXXXXXXXXXXX
TERMII_SENDER_ID=Routta

# --- Identity/document verification provider ---
# NOT INTEGRATED. See src/integrations/verification/README.md.
# This platform requires explicit user approval + a chosen provider before
# any real integration work begins. Only a stub module exists today.
VERIFICATION_PROVIDER=none

# --- Maps / Places / Directions (Google) ---
# GoogleGeocodingProvider (src/modules/places/googleGeocoding.ts, Places Text Search + Geocoding API) and
# the Directions-backed road distance/ETA helper (src/integrations/google/directions.ts) are implemented
# and swappable — see GEOCODING_PROVIDER below. Get a key at
# https://console.cloud.google.com/google/maps-apis — enable "Places API" and "Geocoding API" for
# search/reverse, and "Directions API" (or the newer "Routes API") for real road distance/ETA on trip
# fares/quotes (falls back to the haversine straight-line estimate — src/common/utils/geo.ts — when that
# API isn't enabled, or on any other failure). Restrict this key by server IP and keep it separate from the
# frontend's browser-restricted VITE_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=

# "db" (default) = DbGeocodingProvider over the seeded places_catalog table, haversine trip distance — free,
# no network dependency, coverage only as good as the seed data. "google" = GoogleGeocodingProvider for
# /places/search + /places/reverse, and tries Google Directions for trip fare/quote distance before falling
# back to haversine — real Nigerian coverage, but costs per request and needs GOOGLE_MAPS_SERVER_API_KEY.
# Left as an explicit opt-in; see src/config/env.ts's `geocodingProvider` doc comment for the full tradeoff.
GEOCODING_PROVIDER=db

# --- Logging ---
LOG_LEVEL=info

# --- Background jobs ---
# auto  = use BullMQ when Redis is reachable; in development/test fall back to running the job inline
# queue = always BullMQ (production default behaviour when NODE_ENV=production)
# inline = always run jobs inline in the API process (used by the test suite)
JOBS_MODE=auto

# --- Business rules ---
# Fixed UTC offset in minutes for "today/this week" boundaries (Lagos = +60, no DST)
APP_UTC_OFFSET_MINUTES=60
# Hours a business partner has to accept a requested premium booking before it expires
BOOKING_REQUEST_TTL_HOURS=12
# Commuter cancellation fee (kobo) once a driver has been en route longer than the grace period
CANCEL_FEE_KOBO=30000
CANCEL_FEE_GRACE_SECONDS=120

# --- File storage (driver documents) ---
# local = write to UPLOAD_DIR on disk. r2 = Cloudflare R2 (S3-compatible) — see
# src/integrations/storage/r2.ts. Either way, files are served ONLY through the authenticated
# /api/v1/files route (owner or an admin with verifications.view) — never a public bucket URL.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Required only when STORAGE_DRIVER=r2. Create an R2 bucket + API token (with Object Read & Write)
# at https://dash.cloudflare.com → R2 → Manage API tokens. R2_ACCOUNT_ID is in the R2 dashboard's
# right sidebar (also visible in any R2 API endpoint URL: https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Tests (npm test) ---
# MUST point at a throwaway, empty database whose name contains "test": the suite runs migrations and
# seeds (which delete existing rows) against it.
# TEST_DATABASE_URL=postgres://routta:routta@localhost:5432/routta_test
